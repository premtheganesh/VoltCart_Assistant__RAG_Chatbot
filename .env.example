# Copy this file to .env and fill in the values. Never commit .env.

# ---------- Database (Postgres + pgvector in Docker) ----------
POSTGRES_USER=voltcart
POSTGRES_PASSWORD=voltcart_dev_password
POSTGRES_DB=voltcart
# 5433 on your Mac -> 5432 inside the container (avoids clashing with a local Postgres on 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- LLM (Groq) ----------
GROQ_API_KEY=
LLM_MODEL_MAIN=groq:openai/gpt-oss-120b
LLM_MODEL_SMALL=groq:openai/gpt-oss-20b
# Limit the small model's hidden reasoning: gpt-oss low|medium|high, qwen none|default
LLM_SMALL_REASONING_EFFORT=low

# ---------- Embeddings + rerank (Cohere) ----------
COHERE_API_KEY=
EMBED_PROVIDER=cohere
EMBED_MODEL=embed-multilingual-v3.0
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-v3.5
# The "I don't know" threshold depends on the rerank model: 0.15 for rerank-v3.5,
# 0.10 for rerank-multilingual-v3.0 (re-tune with make eval-retrieval after switching)
MIN_RELEVANCE=0.15
RERANK_TIMEOUT_S=8

# ---------- Guardrails ----------
SAFETY_MODEL=groq:openai/gpt-oss-safeguard-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Optional extra checks (each adds one LLM call per answer)
OUTPUT_GUARD=false
GROUNDING_CHECK=false

# ---------- Observability (Langfuse Cloud) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use the host shown in your Langfuse project settings (EU or US region)
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- API ----------
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHAT_RATE_PER_MINUTE=20
# Admin panel login. Pick a long password; generate a JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
JWT_SECRET=

# Proxies in front of the API (load balancer / platform router), comma-separated IPs: only
# their X-Forwarded-For header is trusted for the visitor's IP (rate limits)
TRUSTED_PROXIES=

# ---------- Evals ----------
# Grades answers in make eval-answers; a different model from LLM_MODEL_MAIN
JUDGE_MODEL=groq:openai/gpt-oss-20b

# ---------- Docker (docker compose up) ----------
# Host ports, and the API address the browser uses (built into the web image)
API_PORT=8000
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:8000

# ---------- App ----------
APP_ENV=dev
LOG_LEVEL=INFO
# text (readable) or json (one object per line, for log tools; the Docker image uses json)
LOG_FORMAT=text
